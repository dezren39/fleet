{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "developing-today/code": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today/openchamber": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today/opencode": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today/zettel": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "dezren39/hatch": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "dezren39/hatch-personal": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "dezren39/nix": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "jnoortheen.nix-ide",
        "golang.Go"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25"
    }
  },
  "name": "fleet",
  "postCreateCommand": "bash -lc 'git submodule update --init --jobs 4 code opencode openchamber nix zettel hatch ; git submodule update --init hatch-personal || echo hatch-personal-skipped-private ; (cd code && direnv allow .) ; nix develop ./code/src/id --command bash -c \"cargo --version && rustc --version\" ; go version ; nix --version'",
  "remoteUser": "vscode"
}